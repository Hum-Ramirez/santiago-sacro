  "item": [
    {
      "name": "1. Autenticacion",
      "item": [
        {
          "name": "Registro de visitante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/api/auth/registro",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Humberto Prueba\",\n  \"correo\": \"humberto.prueba@correo.cl\",\n  \"clave\": \"Clave123\"\n}"
            }
          }
        },
        {
          "name": "Login encargado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/api/auth/login",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"encargado.sanfrancisco@iglesiadesantiago.cl\",\n  \"clave\": \"Encargado123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const datos = pm.response.json();",
                  "pm.collectionVariables.set('token', datos.token);",
                  "pm.test('Devuelve token', function () {",
                  "    pm.expect(datos.token).to.be.a('string');",
                  "});",
                  "pm.test('El rol es ENCARGADO', function () {",
                  "    pm.expect(datos.rol).to.eql('ENCARGADO');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login visitante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
